{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Modulus native extension catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "releases"],
  "properties": {
    "catalog_version": {
      "const": 1
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "extension_id",
          "version",
          "host_effects_cid",
          "artifact_sha256",
          "artifact_url",
          "source_repository",
          "source_revision"
        ],
        "properties": {
          "extension_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          },
          "host_effects_cid": {
            "type": "string",
            "pattern": "^radix-host-effects@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "artifact_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://.+\\.tar\\.gz(?:[?#].*)?$"
          },
          "source_repository": {
            "const": "plures/praxis-platform"
          },
          "source_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      }
    }
  }
}
