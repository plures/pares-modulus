{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Modulus Plugin Manifest",
  "type": "object",
  "required": ["id", "name", "version", "description", "author", "license", "entry", "radix"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Unique plugin identifier (kebab-case)"
    },
    "name": {
      "type": "string",
      "description": "Human-readable plugin name"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+",
      "description": "SemVer version"
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "Emoji or icon identifier"
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 10
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string"
    },
    "radix": {
      "type": "string",
      "description": "Required pares-radix version range"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other modulus plugin IDs this depends on (hard, ID-based — VS Code extensionDependencies analogue)"
    },
    "peerDependencies": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "capabilities": {
      "type": "object",
      "description": "Capability-aware dependencies (ADR-0022/ADR-0024). 'requires' maps a capability name to a semver range the plugin needs a provider for; 'provides' maps a capability name to the semver version this plugin supplies. Resolution: a required capability is satisfied by an installed plugin whose 'provides' (or linked radix CID provided-surface) matches name + semver. An unsatisfied required capability is a gate ERROR.",
      "properties": {
        "requires": {
          "type": "object",
          "description": "capability-name -> semver range (e.g. { \"secrets\": \"^1\", \"storage\": \"^1.2.0\" })",
          "additionalProperties": { "type": "string" }
        },
        "provides": {
          "type": "object",
          "description": "capability-name -> semver version this plugin provides (e.g. { \"secrets\": \"1.0.0\" }). MUST match the plugin's radix CID provided-surface when a CID is linked.",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "string",
      "description": "Path to plugin entry file (relative to plugin dir)"
    },
    "size": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "estimated_bundle": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
